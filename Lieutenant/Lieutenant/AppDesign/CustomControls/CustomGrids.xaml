<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LieutenantGridRadius8" TargetType="Grid">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="LieutenantMacroGrid" TargetType="Grid" BasedOn="{StaticResource LieutenantGridRadius8}">
        <Setter Property="Height" Value="60"/>
        <Setter Property="Width" Value="60"/>
    </Style>
    
    <Style x:Key="LieutenantBackupGrid" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <Style x:Key="LieutenantGridTop" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="LieutenantGridBottom" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style x:Key="LieutenantGridRight" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    
    <Style x:Key="LieutenantMediaTimings" TargetType="Grid" BasedOn="{StaticResource LieutenantGridBottom}">
        <Setter Property="Height" Value="36"/>
    </Style>
</ResourceDictionary>
