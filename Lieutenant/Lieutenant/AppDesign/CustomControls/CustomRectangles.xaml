<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="LieutenantBackgroundRectangle" TargetType="Rectangle">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>
    
    <Style x:Key="LieutenantImageOptionalBlurRectangle" TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource CustomAcrylicInAppLuminosity}"/>
    </Style>
    
    <Style x:Key="LieutenantImageOptionalBlurRectangleFullScreen" TargetType="Rectangle" BasedOn="{StaticResource LieutenantBackgroundRectangle}">
        <Setter Property="Fill" Value="{ThemeResource CustomAcrylicInAppLuminosityAlwaysTransparent}"/>
    </Style>
    
    <Style x:Key="LieutenantImageOptionalBlurRectanglePin" TargetType="Rectangle" BasedOn="{StaticResource LieutenantImageOptionalBlurRectangle}">
        <Setter Property="Fill" Value="{ThemeResource CustomAcrylicInAppLuminositySlightTint}"/>
        <Setter Property="RadiusX" Value="8"/>
        <Setter Property="RadiusY" Value="8"/>
    </Style>

    <Style x:Key="LieutenantImageOptionalBlurRectangleButtonMaskBase" TargetType="Rectangle" BasedOn="{StaticResource LieutenantImageOptionalBlurRectanglePin}">
        <Setter Property="Margin" Value="0,-5,-5,-20"/>
        <Setter Property="Height" Value="37"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="LieutenantImageOptionalBlurRectangleButtonMask" TargetType="Rectangle" BasedOn="{StaticResource LieutenantImageOptionalBlurRectangleButtonMaskBase}">
        <Setter Property="Width" Value="185"/>
    </Style>

    <Style x:Key="LieutenantImageOptionalBlurRectangleButtonMaskNoPin" TargetType="Rectangle" BasedOn="{StaticResource LieutenantImageOptionalBlurRectangleButtonMaskBase}">
        <Setter Property="Width" Value="143"/>
    </Style>

    <Style x:Key="LieutenantFillerRectangle" TargetType="Rectangle">
        <Setter Property="Fill" Value="Transparent"/>
    </Style>
    <!--Very sorry for the redundancy here, but it's what saves the most while keeping my sanity, at least for now. Maybe in 25.7 tho.-->
    <!--YAG-dev @01/07/2025 - Not in 25.7. Apparently this is already efficient.-->
    <Style x:Key="LieutenantImageOptionalBlurRectangleLyricsView" TargetType="Rectangle" BasedOn="{StaticResource LieutenantImageOptionalBlurRectanglePin}">
        <Setter Property="Fill" Value="{ThemeResource CustomAcrylicInAppLuminositySlightTint}"/>
    </Style>
</ResourceDictionary>
