<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="LieutenantDefaultGridView" TargetType="GridView">
        <Setter Property="SelectionMode" Value="None"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LieutenantGridViewDraggable" TargetType="GridView" BasedOn="{StaticResource LieutenantDefaultGridView}">
        <Setter Property="CanDragItems" Value="True"/>
        <Setter Property="CanReorderItems" Value="True"/>
        <Setter Property="AllowDrop" Value="True"/>
    </Style>

    <Style x:Key="LieutenantGridViewNonDraggable" TargetType="GridView" BasedOn="{StaticResource LieutenantDefaultGridView}">
        <Setter Property="CanDragItems" Value="False"/>
        <Setter Property="CanReorderItems" Value="False"/>
        <Setter Property="AllowDrop" Value="False"/>
    </Style>

    <Style x:Key="LieutenantGridViewDraggableLaunchpad" TargetType="GridView" BasedOn="{StaticResource LieutenantGridViewDraggable}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Padding" Value="0,10,0,5"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <Style x:Key="LieutenantGridViewAdd" TargetType="GridView" BasedOn="{StaticResource LieutenantGridViewNonDraggable}">
        <Setter Property="IsItemClickEnabled" Value="True"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <Style x:Key="LieutenantGridViewMain" TargetType="GridView" BasedOn="{StaticResource LieutenantGridViewDraggable}">
        <Setter Property="Margin" Value="0,45,0,0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="LieutenantGridViewLaunchpad" TargetType="GridView" BasedOn="{StaticResource LieutenantGridViewDraggable}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
</ResourceDictionary>
