<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="LieutenantDefaultSlider" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
        <Setter Property="ManipulationMode" Value="All"/>
    </Style>

    <Style x:Key="LieutenantSliderCenter" TargetType="Slider" BasedOn="{StaticResource LieutenantDefaultSlider}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LieutenantSliderSettings" TargetType="Slider" BasedOn="{StaticResource LieutenantSliderCenter}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Width" Value="300"/>
    </Style>

    <Style x:Key="LieutenantSliderMedia" TargetType="Slider" BasedOn="{StaticResource LieutenantSliderCenter}">
        <Setter Property="IsThumbToolTipEnabled" Value="False"/>
    </Style>
</ResourceDictionary>
